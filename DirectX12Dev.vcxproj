    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
       <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <Manifest>
       <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
       <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <Manifest>
       <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>

  <!--
    ==========================================================================
      全構成に共通するコンパイル / リンク設定
      ==========================================
      Condition を付けない ItemDefinitionGroup は全ての構成に適用されます。
      Debug/Release × Win32/x64 の 4 か所に同じ記述を繰り返さずに済みます。
    ==========================================================================
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <!--
        /utf-8 : ソースファイルを UTF-8 として読み、実行文字セットも UTF-8 にする。
                 本プロジェクトのコメントは日本語（UTF-8、BOM なし）で書かれており、
                 このオプションが無いと MSVC がシステムのコードページ (932) と
                 誤認して文字化けや警告 C4819 が発生します。
      -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>

      <!-- ビルドを並列化して高速にする -->
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <!--
        リンクする DirectX 関連のライブラリ
          d3d12.lib       : Direct3D 12 本体 (D3D12CreateDevice など)
          dxgi.lib        : DXGI (CreateDXGIFactory2 など)
          d3dcompiler.lib : HLSL の実行時コンパイル (D3DCompileFromFile)
          dxguid.lib      : IID_ID3D12Device などの GUID の実体。
                            IID_PPV_ARGS を使うとリンク時にこれが必要になります。
        ※ .lib は「DLL の呼び出し方が書かれた案内書」で、実体の DLL は
          Windows に標準搭載されています（別途配布は不要）。
      -->
      <AdditionalDependencies>d3d12.lib;dxgi.lib;d3dcompiler.lib;dxguid.lib;windowscodecs.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

