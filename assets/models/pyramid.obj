# pyramid.obj
#   手で読める大きさのサンプル。法線 (vn) をわざと書いていないので、
#   読み込み側が面の向きから法線を作る経路を通ります。
#   頂点は +Z 側へ傾けてあります。OBJ の +Z は手前なので、
#   右手系から左手系への変換が正しければ、頂点は手前側へ傾いて見えます。
#   このリポジトリで作成したものです。

mtllib pyramid.mtl

o Pyramid

# 底面の 4 隅と頂点
v -1.0 0.0 -1.0
v  1.0 0.0 -1.0
v  1.0 0.0  1.0
v -1.0 0.0  1.0
v  0.0 1.4  0.7

vt 0.0 0.0
vt 1.0 0.0
vt 0.5 1.0
vt 1.0 1.0
vt 0.0 1.0

# 側面 4 枚（外から見て反時計回り）
usemtl Sides
f 1/1 2/2 5/3
f 2/1 3/2 5/3
f 3/1 4/2 5/3
f 4/1 1/2 5/3

# 底面（下から見て反時計回り＝上から見ると時計回り）
usemtl Bottom
f 1/1 4/5 3/4 2/2
