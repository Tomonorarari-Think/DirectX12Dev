//=============================================================================
// Triangle.hlsl
//   三角形を描画するための「シェーダー」プログラム。
//
//   ■ シェーダーとは
//     GPU の上で動く小さなプログラムです。C++ が CPU で動くのに対し、
//     HLSL (High Level Shading Language) で書かれたこのコードは GPU で
//     何千個も同時並列に実行されます。
//
//   ■ このファイルに入っている 2 つのシェーダー
//     1) 頂点シェーダー (Vertex Shader / VS)
//          頂点 1 個につき 1 回呼ばれる。頂点の「最終的な画面上の位置」を決める。
//          三角形は頂点 3 個なので 3 回呼ばれる。
//     2) ピクセルシェーダー (Pixel Shader / PS)
//          画面に塗られるピクセル 1 個につき 1 回呼ばれる。そのピクセルの色を決める。
//          三角形が画面の 1/4 を覆うなら数十万回呼ばれることもある。
//
//   ■ VS と PS の間で起きること（ラスタライズ / Rasterization）
//     VS が出した 3 頂点から、GPU が「その三角形の内側にあるピクセル」を
//     自動的に列挙します。このとき頂点の色などは 3 頂点から自動的に
//     「線形補間」されます。だから頂点に赤・緑・青を置くだけで、
//     中央がなめらかなグラデーションになります。
//=============================================================================


//-----------------------------------------------------------------------------
// 頂点シェーダーへの入力
//   C++ 側の Vertex 構造体（TrianglePipeline.h）と 1 対 1 で対応します。
//
//   ": POSITION" や ": COLOR" は「セマンティクス (semantics)」と呼ばれる目印です。
//   C++ 側の入力レイアウト (D3D12_INPUT_ELEMENT_DESC) で指定した名前と
//   ここの名前が一致することで、GPU は「どのバイト列がどの変数か」を知ります。
//   つまり C++ とシェーダーをつなぐ“接着剤”が、この文字列です。
//-----------------------------------------------------------------------------
struct VSInput
{
    float3 position : POSITION;  // 頂点の座標 (x, y, z)
    float4 color    : COLOR;     // 頂点の色   (r, g, b, a)
};

//-----------------------------------------------------------------------------
// 頂点シェーダーの出力 ＝ ピクセルシェーダーの入力
//
//   SV_POSITION の "SV_" は System Value（システム値）の略で、
//   「GPU が特別扱いする値」であることを示します。
//   SV_POSITION に入れた座標をもとに、GPU はラスタライズを行います。
//   そのため SV_POSITION は必須で、かつ float4 でなければなりません。
//-----------------------------------------------------------------------------
struct VSOutput
{
    float4 position : SV_POSITION; // クリップ空間での座標（GPU が使う特別な値）
    float4 color    : COLOR;       // 補間してピクセルシェーダーに渡したい色
};


//-----------------------------------------------------------------------------
// 頂点シェーダー本体
//
//   今回は座標変換を一切行いません。C++ 側で渡した座標をそのまま出力します。
//   これは学習の第一歩として「座標変換なしでも三角形は出る」ことを示すためです。
//
//   ■ 今回使っている座標系：NDC（正規化デバイス座標 / Normalized Device Coordinates）
//       x : 画面左端 = -1.0、画面右端 = +1.0
//       y : 画面下端 = -1.0、画面上端 = +1.0   ← Y が上向きであることに注意
//       z : 手前 = 0.0、奥 = 1.0
//     つまり (0, 0) が画面のど真ん中です。
//
//   ■ なぜ float4 にして w = 1.0 を入れるのか
//     3D グラフィックスでは座標を 4 成分 (x, y, z, w) の「同次座標」で扱います。
//     w は透視投影（遠くのものを小さく見せる処理）で使う割り算の分母です。
//     GPU はラスタライズ前に x, y, z を w で割ります（透視除算）。
//     今回は透視投影をしないので w = 1.0 とし、割っても値が変わらないようにします。
//-----------------------------------------------------------------------------
VSOutput VSMain(VSInput input)
{
    VSOutput output;

    // 入力の float3 に w = 1.0 を足して float4 にする
    output.position = float4(input.position, 1.0f);

    // 色はそのまま次の段（ラスタライザ）へ受け渡す。
    // ここで渡した値が、三角形内部のピクセルごとに自動補間される。
    output.color = input.color;

    return output;
}


//-----------------------------------------------------------------------------
// ピクセルシェーダー本体
//
//   戻り値に付いている ": SV_TARGET" は
//   「この戻り値を 0 番のレンダーターゲット（＝今回はバックバッファ）に書き込む」
//   という意味のセマンティクスです。
//
//   引数の input.color には、VSMain が出力した 3 頂点分の色を
//   ラスタライザが「このピクセルの位置に応じて混ぜた結果」が入ってきます。
//   自分で補間コードを書く必要はなく、GPU のハードウェアがやってくれます。
//-----------------------------------------------------------------------------
float4 PSMain(VSOutput input) : SV_TARGET
{
    return input.color;
}
