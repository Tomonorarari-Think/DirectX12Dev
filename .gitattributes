# ============================================================================
#  .gitattributes : ファイルの扱い方を Git に指示する設定
# ============================================================================

# 既定はテキストとして自動判別し、リポジトリ内では LF で保存する
* text=auto

# ---------------------------------------------------------------------------
# Windows 専用のファイルは、チェックアウト時に必ず CRLF にする
#   PowerShell スクリプトや MSBuild のプロジェクトファイルは
#   CRLF を前提としたツールに読まれるため、明示しておく
# ---------------------------------------------------------------------------
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.vcxproj   text eol=crlf
*.filters   text eol=crlf
*.slnx      text eol=crlf

# ---------------------------------------------------------------------------
# ソースコードと資料
# ---------------------------------------------------------------------------
*.cpp       text
*.h         text
*.hlsl      text
*.md        text
*.json      text

# ---------------------------------------------------------------------------
# バイナリ（差分を取ろうとしない）
# ---------------------------------------------------------------------------
*.png       binary
*.jpg       binary
*.dds       binary
*.cso       binary
*.exe       binary
*.pdb       binary
