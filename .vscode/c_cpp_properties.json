// ============================================================================
//  c_cpp_properties.json
//    VSCode の C/C++ 拡張が「コードを理解する」ための設定
//    （IntelliSense の設定）。
//
//    ここが正しくないと、
//      ・#include <d3d12.h> に赤波線が出る
//      ・関数の候補が出てこない / 定義へジャンプできない
//    といった状態になります。ビルド自体は MSBuild が行うため
//    通らなくてもビルドはできますが、快適さが大きく変わります。
// ============================================================================
{
  "version": 4,
  "configurations": [
    {
      "name": "Win32",

      // ------------------------------------------------------------------
      // includePath : ヘッダーを探す場所
      //   ${workspaceFolder}/** … プロジェクト内を再帰的に探す
      //   Windows SDK や MSVC 標準ヘッダの場所は、下の compilerPath から
      //   拡張機能が自動的に判別してくれるため、明示しなくて構いません。
      // ------------------------------------------------------------------
      "includePath": [
        "${workspaceFolder}/src/**"
      ],

      // ------------------------------------------------------------------
      // defines : IntelliSense 上で有効にするプリプロセッサ定義
      //   _DEBUG を入れておくことで、#if defined(_DEBUG) のブロックが
      //   「無効なコード」としてグレーアウトされなくなります。
      // ------------------------------------------------------------------
      "defines": [
        "_DEBUG",
        "UNICODE",
        "_UNICODE"
      ],

      // ------------------------------------------------------------------
      // compilerPath : 使用するコンパイラ (cl.exe) の場所
      //
      //   ★ 環境によってパスが異なります。
      //     Visual Studio のバージョン (18)、エディション (Community)、
      //     MSVC のバージョン番号 (14.xx.xxxxx) は各自の環境に合わせて
      //     書き換えてください。
      //
      //   確認方法（PowerShell）:
      //     Get-ChildItem "C:\Program Files\Microsoft Visual Studio\18\Community\VC\Tools\MSVC"
      //
      //   ※ この項目を空文字 "" にすると、拡張機能が自動検出を試みます。
      //     パスが分からない場合は "" にしておくのも手です。
      // ------------------------------------------------------------------
      "compilerPath": "",

      "cStandard": "c17",

      // vcxproj の LanguageStandard (stdcpp20) と揃える
      "cppStandard": "c++20",

      // MSVC + x64 としてコードを解釈する
      "intelliSenseMode": "windows-msvc-x64"
    }
  ]
}
