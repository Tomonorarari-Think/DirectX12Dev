<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
    .vcxproj.filters
      Visual Studio の「ソリューション エクスプローラー」上での
      フォルダ表示（仮想フォルダ）を定義するファイル。
      実際のディスク上のフォルダ構成とは独立していますが、
      本プロジェクトでは分かりやすさのため一致させています。
      ビルド結果には一切影響しません。
  ============================================================================
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Filter Include="src">
      <UniqueIdentifier>{a1000000-0000-4000-8000-000000000001}</UniqueIdentifier>
    </Filter>
    <Filter Include="src\App">
      <UniqueIdentifier>{a1000000-0000-4000-8000-000000000002}</UniqueIdentifier>
    </Filter>
    <Filter Include="src\Common">
      <UniqueIdentifier>{a1000000-0000-4000-8000-000000000003}</UniqueIdentifier>
    </Filter>
    <Filter Include="src\Graphics">
      <UniqueIdentifier>{a1000000-0000-4000-8000-000000000004}</UniqueIdentifier>
    </Filter>
    <Filter Include="shaders">
      <UniqueIdentifier>{a1000000-0000-4000-8000-000000000005}</UniqueIdentifier>
    </Filter>
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="src\main.cpp">
      <Filter>src</Filter>
    </ClCompile>
    <ClCompile Include="src\App\Window.cpp">
      <Filter>src\App</Filter>
    </ClCompile>
    <ClCompile Include="src\Common\GraphicsCommon.cpp">
      <Filter>src\Common</Filter>
    </ClCompile>
    <ClCompile Include="src\Graphics\CommandQueue.cpp">
      <Filter>src\Graphics</Filter>
    </ClCompile>
    <ClCompile Include="src\Graphics\GraphicsDevice.cpp">
      <Filter>src\Graphics</Filter>
    </ClCompile>
    <ClCompile Include="src\Graphics\Renderer.cpp">
      <Filter>src\Graphics</Filter>
    </ClCompile>
    <ClCompile Include="src\Graphics\SwapChain.cpp">
      <Filter>src\Graphics</Filter>
    </ClCompile>
    <ClCompile Include="src\Graphics\TrianglePipeline.cpp">
      <Filter>src\Graphics</Filter>
    </ClCompile>
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="src\App\Window.h">
      <Filter>src\App</Filter>
    </ClInclude>
    <ClInclude Include="src\Common\GraphicsCommon.h">
      <Filter>src\Common</Filter>
    </ClInclude>
    <ClInclude Include="src\Graphics\CommandQueue.h">
      <Filter>src\Graphics</Filter>
    </ClInclude>
    <ClInclude Include="src\Graphics\GraphicsDevice.h">
      <Filter>src\Graphics</Filter>
    </ClInclude>
    <ClInclude Include="src\Graphics\Renderer.h">
      <Filter>src\Graphics</Filter>
    </ClInclude>
    <ClInclude Include="src\Graphics\SwapChain.h">
      <Filter>src\Graphics</Filter>
    </ClInclude>
    <ClInclude Include="src\Graphics\TrianglePipeline.h">
      <Filter>src\Graphics</Filter>
    </ClInclude>
  </ItemGroup>

  <ItemGroup>
    <None Include="shaders\Triangle.hlsl">
      <Filter>shaders</Filter>
    </None>
  </ItemGroup>
</Project>
