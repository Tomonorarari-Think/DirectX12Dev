# ============================================================================
#  .gitignore : Git の追跡対象から外すファイル/フォルダの指定
#  ----------------------------------------------------------------------
#  Visual Studio / MSBuild は「ビルドすれば再生成できる中間物」を大量に
#  吐き出します。これらをリポジトリに含めると、
#    ・容量が肥大化する
#    ・環境依存のパスが混入して他PCで壊れる
#    ・毎回巨大な差分が出てレビューできない
#  ため、すべて除外します。
#
#  【注意】.gitignore は「行末コメント」に対応していません。
#          `.vs/   # コメント` と書くと "# コメント" までがパターンの一部と
#          みなされ、除外が効かなくなります。コメントは必ず独立行に書くこと。
# ============================================================================

# ---------------------------------------------------------------------------
# Visual Studio のユーザー固有設定 / キャッシュ
#   .vs/           … IntelliSense DB、ウィンドウレイアウト等（個人設定）
#   *.vcxproj.user … デバッグ時の作業ディレクトリ等（個人設定）
# ---------------------------------------------------------------------------
.vs/
*.vcxproj.user
*.suo
*.userosscache
*.sln.docstates

# ---------------------------------------------------------------------------
# ビルド出力（.obj / .exe / .pdb / .ilk など）
# ---------------------------------------------------------------------------
[Dd]ebug/
[Rr]elease/
[Ww]in32/
[Xx]64/
[Bb]uild/
[Bb]in/
[Oo]bj/
ipch/
*.obj

# ---------------------------------------------------------------------------
# ただし assets/models/ の .obj は「サンプルモデル」であって
# ビルドの中間物ではない。上の *.obj に巻き込まれるので除外し直す。
#   ★ CI のリンク切れ検査で気付いた。手元にはファイルがあるのに、
#     clone した人には無い状態だった。
# ---------------------------------------------------------------------------
!assets/models/*.obj
*.exe
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb
*.tlog
*.log
*.lastbuildstate
*.res
*.pch
*.aps

# ---------------------------------------------------------------------------
# コンパイル済みシェーダー（.hlsl から生成されるため追跡不要）
# ---------------------------------------------------------------------------
*.cso
*.fxc

# ---------------------------------------------------------------------------
# OS が勝手に作るファイル
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# VSCode
#   tasks.json / launch.json などチーム共有したい設定は「追跡する」ため、
#   .vscode/ 全体は無視せず、個人用・キャッシュ系だけをピンポイントで除外。
# ---------------------------------------------------------------------------
.vscode/ipch/
.vscode/*.db
.vscode/settings.local.json

# ---------------------------------------------------------------------------
# Node の依存（tools/checks/mermaid で Mermaid の構文検証に使う）
#   package.json は追跡し、取得結果は追跡しない。
#     cd tools\checks\mermaid; npm install
# ---------------------------------------------------------------------------
node_modules/
package-lock.json

# ---------------------------------------------------------------------------
# AI 支援ツールのローカル設定
#   作業者ごとの取り決めであって、このリポジトリの成果物ではない。
#   公開する内容は README と docs/ に置く。
# ---------------------------------------------------------------------------
CLAUDE.md
AGENTS.md
.claude/
.cursor/
.aider*
.github/copilot-instructions.md
